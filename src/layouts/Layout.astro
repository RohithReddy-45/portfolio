---
import "@fontsource-variable/roboto";
import { config } from "@/data/config";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={config.description} />
    <meta name="keywords" content={config.keywords} />
    <meta property="og:title" content={config.siteTitle} />
    <meta property="og:description" content={config.description} />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://rohith-reddy.vercel.app/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-image.png" />
    <meta name="twitter:site" content={config.social.twitter} />
    <meta name="twitter:title" content={config.siteTitle} />
    <meta name="twitter:description" content={config.description} />
    <meta name="twitter:app:name:iphone" content="Rohith reddy - Software Engineer" />
    <meta name="twitter:app:name:ipad" content="Rohith reddy - Software Engineer" />
    <meta name="twitter:app:name:googleplay" content="Rohith reddy - Software Engineer" />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="1cbb53ee-b266-43b6-9137-63efef29a8e6"></script>
    <title>Rohith reddy - Software Engineer</title>
  </head>
  <body
    class="antialiased bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-200 min-w-[320px]"
  >
    <slot />
  </body>
</html>

<style is:global>
  body{
    font-family: 'Roboto Variable', sans-serif;
  }

  ::selection {
    background-color: #7109e9;
    color: #f1f5f9;
  }

  ::-moz-selection {
    background-color: #7109e9;
    color: #f1f5f9;
  }
</style>
